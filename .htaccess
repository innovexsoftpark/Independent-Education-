# Independent Education - speed and security settings for Apache / cPanel hosting
# (if your host uses Nginx or LiteSpeed without .htaccess, ask them to enable
#  gzip/brotli compression and browser caching instead)

# Compress text files (HTML, CSS, JS, SVG, JSON) - makes the page much smaller
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml application/javascript application/json image/svg+xml application/xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json image/svg+xml application/xml
</IfModule>

# Let browsers keep images and icons for a year, the page itself for a short time
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/html "access plus 10 minutes"
  # the style and script files get a new ?v= number whenever they change, so they can be kept for a year
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Always use HTTPS (turn on SSL in your hosting panel first)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Basic security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Never serve the upload instructions or n8n files if they are uploaded by mistake
<FilesMatch "^(HOW-TO-UPLOAD|MARKETING-TOOLS|SEO-GUIDE)\.txt$">
  Require all denied
</FilesMatch>
RedirectMatch 404 ^/n8n-automation-DO-NOT-UPLOAD/

# Service worker and app manifest: always check for a fresh copy
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "^(sw\.js|site\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Friendly page for broken links
ErrorDocument 404 /404.html
